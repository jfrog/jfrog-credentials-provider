{
  "realm": "jfrog-poc",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "clients": [
    {
      "clientId": "jfrog-credential-provider",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "secret": "poc-test-secret-not-for-prod",
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocolMappers": [
        {
          "name": "jfrog-audience-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "jfrog-artifactory-poc",
            "id.token.claim": "true",
            "access.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "poc-user",
      "enabled": true,
      "emailVerified": true,
      "email": "poc-user@example.invalid",
      "firstName": "Poc",
      "lastName": "User",
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "poc-password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "offline_access",
        "uma_authorization"
      ]
    }
  ]
}
